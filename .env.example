# ============================================================================
# FantaFac Smart Production Assistant — Environment Configuration (.env.example)
# ============================================================================

# 1. Supabase Configuration (Optional for Local Demo Mode)
# When omitted, the application runs in clearly badged Local Demo Persistence Mode
# backed by localStorage and deterministic seed hydration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. AI Production Assistant Configuration (Optional)
# Supports OpenAI-compatible or Gemini API endpoints on the server only.
# When omitted, the assistant runs in Grounded Deterministic Analysis Mode over live factory state.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gemini-2.0-flash
AI_PROVIDER_BASE_URL=

# 3. Default Facility / Operational Settings
NEXT_PUBLIC_DEFAULT_FACILITY_ID=FAC-NORTH-01
NEXT_PUBLIC_QUALITY_DEFECT_THRESHOLD_PCT=2.5
